SIGA_DB_SERVER=servidorapidelta\SQLSTANDARD
SIGA_DB_NAME=Siga
SIGA_READ_UID=
SIGA_READ_PWD=
SIGA_STOCK_UID=
SIGA_STOCK_PWD=

# ── Autenticación ──────────────────────────────────────────────────────────────
# Secreto para firmar la cookie de sesión. Si se deja vacío se genera uno
# aleatorio en cada arranque (las sesiones activas se invalidan al reiniciar).
# En producción, fijar un valor estable y secreto.
SESSION_SECRET=
# Contraseña del admin inicial (usuario "admin"). Sólo se usa la primera vez,
# cuando data/usuarios.json está vacío. Si se deja vacío se genera una aleatoria
# y se imprime una única vez en la consola del servidor.
AUTH_ADMIN_PASSWORD=

# ── Facturador ─────────────────────────────────────────────────────────────────
# Carpeta compartida con la planilla de precios del facturador (fuente 2, se usa cuando
# SQL no responde). Se toma la planilla mas nueva de la carpeta.
PRECIOS_FACTURADOR_DIR=\\192.168.1.26\Apidelta\7- SISTEMA\1-Precios\PreciosFacturador
